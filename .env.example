# Conexão com o banco do Outcome.
#
# ATENÇÃO AO HOST, é a pegadinha deste arquivo:
#
#   · dentro do compose   → o docker-compose.yml já define MYSQL_HOST: db em
#                           `environment`, que tem precedência sobre este
#                           arquivo. Não precisa fazer nada.
#   · na sua máquina      → `uv run pytest`, `uv run uvicorn`. Aqui `db` NÃO
#                           resolve: é nome de serviço da rede do Docker.
#                           Use o mesmo MYSQL_HOST do outcome_api/.env
#                           (tipicamente localhost).
#
# Ou seja: este arquivo é o "quando eu rodo fora do container", e por isso o
# padrão abaixo é localhost e não db.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=outcome_db

# Usado quando a modalidade não define o seu. 300 kg/m³ é o padrão rodoviário.
FATOR_CUBAGEM_PADRAO=300
DIAS_COLETA_PADRAO=1

LOG_NIVEL=INFO
